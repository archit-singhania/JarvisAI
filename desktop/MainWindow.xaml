<Window x:Class="JarvisAI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:JarvisAI" Title="Wednesday · JarvisAI" Width="1220" Height="840" MinWidth="860" MinHeight="650" WindowStartupLocation="CenterScreen">
  <Window.DataContext><local:MainViewModel/></Window.DataContext>
  <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="22"><DockPanel Margin="18">
      <StackPanel DockPanel.Dock="Top"><TextBlock Text="◒ Wednesday" FontSize="25" FontWeight="SemiBold" Margin="5,10,0,4"/><TextBlock Text="A SPACE TO THINK CLEARLY" Foreground="{DynamicResource TextSecondary}" FontSize="9" Margin="7,0,0,24"/>
        <Button Content="＋ New conversation" Command="{Binding ClearChatCommand}"/>
        <Button Content="◉  Assistant" Command="{Binding OpenSectionCommand}" CommandParameter="Assistant"/>
        <Button Content="▤  Knowledge" Command="{Binding OpenSectionCommand}" CommandParameter="Knowledge"/>
        <Button Content="◇  Memory" Command="{Binding OpenSectionCommand}" CommandParameter="Memory"/>
        <Button Content="◷  Reminders" Command="{Binding OpenSectionCommand}" CommandParameter="Reminders"/>
        <Button Content="⌘  Tools" Command="{Binding OpenSectionCommand}" CommandParameter="Tools"/>
        <Button Content="↻  Workflows" Command="{Binding OpenSectionCommand}" CommandParameter="Workflows"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom"><Button Content="Preferences" Command="{Binding OpenPreferencesCommand}"/><Button Content="Export workspace ↗" Command="{Binding ExportCommand}"/><Button Content="Reconnect" Command="{Binding ReconnectCommand}"/><TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="5,12,5,8"/></StackPanel><Grid/>
    </DockPanel></Border>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="18,12"><TextBlock Text="YOUR THINKING SPACE" FontSize="10" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding Section}" FontSize="30" FontWeight="Light" Margin="0,6,0,0"/></StackPanel>
      <Grid Grid.Row="1" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Assistant}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ListBox ItemsSource="{Binding Messages}" Margin="18,0,18,12"><ListBox.ItemTemplate><DataTemplate><Border Padding="24" Background="{DynamicResource BgPanel}" CornerRadius="18"><StackPanel><DockPanel><TextBlock Text="{Binding Sender}" FontSize="11" Foreground="{DynamicResource AccentCyan}"/><TextBlock Text="{Binding Timestamp}" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="15" LineHeight="26" Margin="0,12,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
        <Border Grid.Row="1" Background="{DynamicResource BgPanel}" CornerRadius="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16" Margin="18,0,18,6"><StackPanel>
          <TextBox Text="{Binding InputText,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MaxHeight="140" MinHeight="55" KeyDown="InputBox_KeyDown" AutomationProperties.Name="Message Wednesday"/>
          <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="＋ Import" Command="{Binding ImportDocumentCommand}" Margin="0,0,8,0"/><Button Content="▧ Image" Command="{Binding ScreenAnalyzeCommand}" Margin="0,0,8,0"/><CheckBox Content="Speak" IsChecked="{Binding SpeakResponses}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="■ Stop" Command="{Binding InterruptCommand}" Margin="0,0,8,0"/><Button Content="Voice" Command="{Binding ToggleMicCommand}" Margin="0,0,8,0"/><Button Content="Send ↑" Background="{DynamicResource AccentCyan}" Foreground="{DynamicResource BgDeep}" Command="{Binding SendTextCommand}"/></StackPanel></DockPanel>
          <ItemsControl ItemsSource="{Binding WaveformBars}" HorizontalAlignment="Center" Height="25"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="3" Height="{Binding}" Background="{DynamicResource AccentCyan}" CornerRadius="2" Margin="2,0" VerticalAlignment="Center"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></Border>
      </Grid>
      <ScrollViewer Grid.Row="1" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Knowledge|Memory|Reminders|Tools|Workflows}" Margin="18,0,18,0"><StackPanel>
        <Button Content="＋ Import a document" Command="{Binding ImportDocumentCommand}" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Knowledge}" HorizontalAlignment="Left"/>
        <Border Background="{DynamicResource BgPanel}" CornerRadius="18" Padding="22" Margin="0,0,0,20" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Memory|Reminders|Workflows}"><StackPanel><TextBlock Text="Title or reminder"/><TextBox Text="{Binding RecordTitle,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Content · workflows: time, weather, or search: query per line" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Memory|Workflows}"/><TextBox Text="{Binding RecordContent,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Memory|Workflows}"/><TextBlock Text="Local date and time · yyyy-MM-dd HH:mm" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Reminders}"/><TextBox Text="{Binding ReminderTime}" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Reminders}"/><Button Content="Save" Command="{Binding SaveRecordCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
        <StackPanel Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Tools}"><TextBlock Text="Query for search"/><TextBox Text="{Binding RecordContent}"/><StackPanel Orientation="Horizontal"><Button Content="Current time" Command="{Binding RunToolCommand}" CommandParameter="time" Margin="0,0,8,16"/><Button Content="Weather" Command="{Binding RunToolCommand}" CommandParameter="weather" Margin="0,0,8,16"/><Button Content="Search" Command="{Binding RunToolCommand}" CommandParameter="search" Margin="0,0,8,16"/></StackPanel></StackPanel>
        <ListBox ItemsSource="{Binding Items}"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource BgPanel}" CornerRadius="18" Padding="22"><StackPanel><TextBlock Text="{Binding Title}" FontSize="17"/><TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Edit memory" Command="{Binding DataContext.EditRecordCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,8,0" Visibility="{Binding DataContext.Section,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource SectionVisibility},ConverterParameter=Memory}"/><Button Content="Run workflow" Command="{Binding DataContext.RunWorkflowCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,8,0" Visibility="{Binding DataContext.Section,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource SectionVisibility},ConverterParameter=Workflows}"/><Button Content="Remove / cancel" Command="{Binding DataContext.RemoveRecordCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding DataContext.Section,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource SectionVisibility},ConverterParameter=Knowledge|Memory|Reminders|Workflows}"/></StackPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
      </StackPanel></ScrollViewer>
      <ScrollViewer Grid.Row="1" Margin="18,0,18,0" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=Preferences}"><Border Background="{DynamicResource BgPanel}" CornerRadius="18" Padding="26"><StackPanel><TextBlock Text="Make it feel like yours." FontSize="24" Margin="0,0,0,18"/><TextBlock Text="Appearance · system / light / dark"/><TextBox Text="{Binding Appearance}"/><TextBlock Text="Model provider · ollama / groq / openai / gemini"/><TextBox Text="{Binding ModelProvider}"/><TextBlock Text="Local model"/><TextBox Text="{Binding LocalModel}"/><TextBlock Text="Cloud model"/><TextBox Text="{Binding CloudModel}"/><TextBlock Text="Focus · assistant / coding / research / focus"/><TextBox Text="{Binding Focus}"/><TextBlock Text="Speech language code"/><TextBox Text="{Binding Language}"/><CheckBox Content="Speak responses" IsChecked="{Binding SpeakResponses}"/><CheckBox Content="Reduce motion" IsChecked="{Binding ReduceMotion}"/><CheckBox Content="Reduce transparency" IsChecked="{Binding ReduceTransparency}"/><Button Content="Save preferences" Command="{Binding SavePreferencesCommand}" HorizontalAlignment="Left"/></StackPanel></Border></ScrollViewer>
    </Grid>
  </Grid>
</Window>
